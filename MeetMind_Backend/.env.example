# MeetMind AI Backend Environment Configuration

# Server Settings
ENVIRONMENT=development
PORT=8000
SECRET_KEY=your-super-secret-key-change-this-in-production

# Supabase Credentials (Database, Auth & Storage)
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your-supabase-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key

# Gemini API Key Pool (Up to 5 keys for rate-limit rotation & exponential backoff)
GEMINI_API_KEY_1=your-gemini-key-1
GEMINI_API_KEY_2=your-gemini-key-2
GEMINI_API_KEY_3=your-gemini-key-3
GEMINI_API_KEY_4=your-gemini-key-4
GEMINI_API_KEY_5=your-gemini-key-5

# OpenRouter API Key Pool (Fallback model provider)
OPENROUTER_API_KEY_1=your-openrouter-key-1
OPENROUTER_API_KEY_2=your-openrouter-key-2

# AssemblyAI API Key (Speech-to-text & Diarization)
ASSEMBLYAI_API_KEY=your-assemblyai-api-key
