{
  "manifest_version": 3,
  "name": "MeetMind AI Assistant",
  "version": "1.0.0",
  "description": "Capture, transcribe, and query meetings in real-time.",
  "permissions": [
    "activeTab",
    "tabCapture",
    "storage",
    "offscreen"
  ],
  "host_permissions": [
    "http://localhost:8000/*",
    "https://*.supabase.co/*"
  ],
  "action": {
    "default_popup": "src/popup/popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "background": {
    "service_worker": "background.js",
    "type": "module"
  }
}
